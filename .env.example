# ===== 必改 =====
# JWT 签名密钥：改成一段足够长的随机字符串（生产环境务必更换）
SECRET_KEY=change-me-to-a-long-random-string

# ===== 可选 =====
# DeepSeek 密钥：不填也能做检测，只是"AI 解读"接口不可用
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# 模型权重路径（默认 ../models/best.pt）
# LESION_MODEL=../models/best.pt

# CORS 白名单，逗号分隔；生产环境建议改成前端实际域名
ALLOW_ORIGINS=*

# 登录 token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=30
